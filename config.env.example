# The API Key is the password to your instance, set when configuring indexer and downloader in Lidarr
# Set any value you wish here, but do not leave it empty
API_KEY=your_secret_password
API_LINK=https://qobuz-api.stremio123.duckdns.org

# Alternative API links (uncomment to use):
# API_LINK=https://qobuz.squid.wtf/api
# API_LINK=https://qobuz-api1.onrender.com
# API_LINK=https://trypt-hifi-dl-456461932686.us-west1.run.app

# Quality presets: mp3-320, flac-lossless, flac-hi-res (also: format_id 6 = FLAC 16-bit CD)

# Qobuz authentication token. If set, the app will use the official Qobuz API
# for search, album metadata, and download URLs, falling back to API_LINK if needed.
# Get this from your Qobuz account's browser cookies (user_auth_token).
QOBUZ_TOKEN=

DOWNLOAD_PATH=D:\Appz\squidarr
PORT=8687
CATEGORY=music
QUALITY=flac-hi-res
TZ=Europe/Paris
DEBUG=false
