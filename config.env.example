# Required: choose your own private API password and download folder.
API_KEY=replace_with_a_private_password
DOWNLOAD_PATH=C:\Downloads\squidarr

# Defaults are already supplied; normally omit PORT=8687, CATEGORY=music,
# TZ=Europe/Paris, QUALITY=flac, and DEBUG=false.
# Required for Deezer downloads (the key is not bundled with the app).
DEEZER_API_KEY=your_deezer_key

# Active Qobuz backend. It provides search, album metadata and full-length streams.
QOBUZ_NAV_LINK=https://qobuz.itzsantiax.qzz.io

# Optional official Qobuz API credentials. Omit to use Navidrums only.
# QOBUZ_TOKEN=
# APP_ID=
# APP_SECRET=

# Optional Tidal backend: one or more hifi-api base URLs, comma separated.
# Search, album metadata and downloads go through it. Tidal joins the combined
# search only when this is set. The public instances die when their backing
# Tidal account is banned, so list a fallback.
# TIDAL_API_LINK=https://your-hifi-api-instance.example,https://your-fallback.example

# Optional Tidal quality: LOSSLESS (FLAC, the default) or HIGH (AAC-LC 320,
# written as .m4a, roughly a third of the size). Either tier is accepted if the
# instance demotes the other, and the release folder names what it really got.
# TIDAL_QUALITY=HIGH

# Optional Qobuz quality override.
# QUALITY=mp3-320
